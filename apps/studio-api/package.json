{
  "name": "studio-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply fastforge-studio --local",
    "migrate": "wrangler d1 migrations apply fastforge-studio --remote",
    "typecheck": "cargo check -p studio-api --target wasm32-unknown-unknown"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
